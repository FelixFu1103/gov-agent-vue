{
  "name": "jiangsu-medical-insurance-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "test": "node --test",
    "db:start": "docker compose up -d postgres ollama",
    "rerank:start": "docker compose up -d reranker",
    "rerank:logs": "docker compose logs -f reranker",
    "rerank:stop": "docker compose stop reranker",
    "db:model": "docker compose exec ollama ollama pull bge-m3",
    "knowledge:sync": "node scripts/sync-official-knowledge.mjs",
    "knowledge:pdf": "python3 scripts/extract-official-pdfs.py",
    "knowledge:validate": "node --env-file-if-exists=.env scripts/validate-knowledge.mjs",
    "db:stop": "docker compose down",
    "db:ingest": "node --env-file-if-exists=.env scripts/ingest-knowledge.mjs",
    "eval:retrieval": "node --env-file-if-exists=.env scripts/evaluate-retrieval.mjs",
    "eval:rag": "node --env-file-if-exists=.env scripts/evaluate-rag-comparison.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}
