DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
PORT=8787
DATABASE_URL=postgresql://gov_agent:gov_agent_dev@127.0.0.1:5432/gov_agent

# 默认使用 Docker 中的本地 Ollama，不向第三方发送知识正文
EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_CHUNK_SIZE=180
KNOWLEDGE_CHUNK_OVERLAP=30
# 云端 OpenAI 兼容接口才需要配置该项
# EMBEDDING_API_KEY=your_embedding_api_key_here

# 可选：兼容 Jina/Cohere 风格的 /rerank 接口；未配置时自动使用 RRF 排序
# 推荐中文模型：BAAI/bge-reranker-v2-m3
# RERANK_API_URL=https://your-provider.example/v1/rerank
# RERANK_API_KEY=your_rerank_api_key_here
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TIMEOUT_MS=15000
